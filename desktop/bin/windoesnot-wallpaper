#!/usr/bin/env python3
"""Start swaybg from the existing per-monitor hyprpaper.conf settings."""

import os
from pathlib import Path
import signal
import subprocess
import sys
import time


PIDFILE = Path(os.environ.get("XDG_RUNTIME_DIR", f"/tmp/windoesnot-{os.getuid()}")) / "windoesnot-wallpaper.pids"
CONFIG = Path.home() / ".config/hypr/hyprpaper.conf"


def read_wallpapers():
    """Read existing hyprpaper wallpaper blocks without changing user data."""
    wallpapers = []
    monitor = ""
    image = ""
    in_block = False
    try:
        lines = CONFIG.read_text().splitlines()
    except OSError:
        return wallpapers
    for line in lines:
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        if line == "wallpaper {":
            monitor = image = ""
            in_block = True
        elif line == "}" and in_block:
            if image:
                wallpapers.append((monitor, os.path.expanduser(image)))
            in_block = False
        elif in_block and "=" in line:
            key, value = (part.strip() for part in line.split("=", 1))
            if key == "monitor":
                monitor = value
            elif key == "path":
                image = value
    return wallpapers


def stop_previous():
    try:
        pids = [int(pid) for pid in PIDFILE.read_text().split()]
    except (OSError, ValueError):
        pids = []
    for pid in pids:
        if not is_our_swaybg(pid):
            continue
        try:
            os.kill(pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
    deadline = time.monotonic() + 2
    while time.monotonic() < deadline:
        living = []
        for pid in pids:
            if not is_our_swaybg(pid):
                continue
            try:
                os.kill(pid, 0)
                living.append(pid)
            except ProcessLookupError:
                pass
        if not living:
            break
        time.sleep(0.05)
    for pid in pids:
        if not is_our_swaybg(pid):
            continue
        try:
            os.kill(pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    PIDFILE.unlink(missing_ok=True)


def is_our_swaybg(pid):
    """Avoid signaling an unrelated process if a stale PID was reused."""
    try:
        command = Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0", 1)[0]
    except OSError:
        return False
    return Path(os.fsdecode(command)).name == "swaybg"


def main():
    if len(sys.argv) > 1 and sys.argv[1] != "--restart":
        print("usage: windoesnot-wallpaper [--restart]", file=sys.stderr)
        return 2
    stop_previous()
    if not shutil_which("swaybg"):
        print("windoesnot-wallpaper: swaybg is not installed", file=sys.stderr)
        return 1
    jobs = [(monitor, image) for monitor, image in read_wallpapers() if Path(image).is_file()]
    log_path = Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))) / "windoesnot" / "swaybg.log"
    log_path.parent.mkdir(parents=True, exist_ok=True)

    def launch(monitor, image):
        command = ["swaybg", "-i", image, "-m", "fill"]
        if monitor:
            command += ["-o", monitor]
        with open(log_path, "ab") as log:
            return subprocess.Popen(command, start_new_session=True, stdin=subprocess.DEVNULL,
                                    stdout=log, stderr=log)

    running = {job: launch(*job) for job in jobs}
    # swaybg exits at once when the output is not ready yet (login) or the name is wrong:
    # check shortly after the start and retry a few times instead of leaving no wallpaper.
    delay = float(os.environ.get("WINDOESNOT_WALLPAPER_CHECK_DELAY", "1.5"))
    for _ in range(3 if running else 0):
        time.sleep(delay)
        failed = [job for job, proc in running.items() if proc.poll() is not None]
        if not failed:
            break
        for job in failed:
            running[job] = launch(*job)
    processes = [proc for proc in running.values() if proc.poll() is None]
    for job, proc in running.items():
        if proc.poll() is not None:
            print(f"windoesnot-wallpaper: swaybg for {job[0] or 'all outputs'} keeps failing, see {log_path}", file=sys.stderr)
    if processes:
        PIDFILE.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        PIDFILE.write_text("\n".join(str(proc.pid) for proc in processes) + "\n")
    return 0


def shutil_which(command):
    from shutil import which
    return which(command)


if __name__ == "__main__":
    raise SystemExit(main())
