#!/usr/bin/python3 -I
"""Notification popup settings for swaync: position on the screen and Do Not Disturb.

get                      -> {"position": "top-right", "dnd": false}
position <name>          top-left | top-center | top-right | bottom-left | bottom-center | bottom-right
dnd on|off               on = popups muted (Do Not Disturb)
Only positionX/positionY of ~/.config/swaync/config.json are changed; everything else stays as it is.
"""
import json
import os
import subprocess
import sys
import tempfile
from pathlib import Path

CONFIG = Path(os.environ.get('XDG_CONFIG_HOME') or Path.home() / '.config') / 'swaync/config.json'
X = {'left': 'left', 'center': 'center', 'right': 'right'}
Y = {'top': 'top', 'bottom': 'bottom'}


def client(*args):
    try:
        return subprocess.run(['swaync-client', *args], capture_output=True, text=True, timeout=10, check=False)
    except (OSError, subprocess.SubprocessError):
        return None


def read():
    try:
        return json.loads(CONFIG.read_text())
    except (OSError, ValueError):
        return {}


def get():
    data = read()
    dnd = client('-D')
    return {'position': '%s-%s' % (data.get('positionY', 'top'), data.get('positionX', 'right')),
            'dnd': bool(dnd and dnd.stdout.strip() == 'true')}


def set_position(name):
    parts = name.split('-')
    if len(parts) != 2 or parts[0] not in Y or parts[1] not in X:
        raise SystemExit('invalid position')
    data = read()
    if not data:
        raise SystemExit('swaync config missing')
    data['positionY'], data['positionX'] = parts[0], parts[1]
    # The notification centre keeps its own place (top centre); only the popups move.
    data['control-center-positionX'] = 'center'
    data['control-center-positionY'] = 'top'
    fd, tmp = tempfile.mkstemp(prefix='.config-', dir=CONFIG.parent)
    with os.fdopen(fd, 'w') as stream:
        json.dump(data, stream, indent=2, ensure_ascii=False)
        stream.write('\n')
    os.replace(tmp, CONFIG)
    client('-R')      # reload config
    client('-rs')     # reload styles


def main(argv):
    if argv[:1] == ['get']:
        print(json.dumps(get()))
    elif len(argv) == 2 and argv[0] == 'position':
        set_position(argv[1])
    elif len(argv) == 2 and argv[0] == 'dnd' and argv[1] in ('on', 'off'):
        client('-dn' if argv[1] == 'on' else '-df')
    else:
        raise SystemExit(__doc__)
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
