#!/usr/bin/env python3
"""Apply a one-shot layout transition to existing normal client windows."""
import json
import subprocess
import sys


def eligible(client):
    workspace = client.get("workspace") or {}
    return (
        not client.get("fullscreen", False)
        and not client.get("pinned", False)
        and workspace.get("id", -1) > 0
        and "quickshell" not in (client.get("class") or "").lower()
    )


def logical_monitor(client, monitors):
    for monitor in monitors:
        scale = max(0.25, float(monitor.get("scale", 1)))
        width, height = round(monitor["width"] / scale), round(monitor["height"] / scale)
        if int(monitor.get("transform", 0)) % 2:
            width, height = height, width
        x, y = monitor["x"], monitor["y"]
        if x <= client["at"][0] < x + width and y <= client["at"][1] < y + height:
            return monitor, x, y, width, height
    return None


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in ("floating", "tiling"):
        print("Usage: windoesnot-transition-window-mode floating|tiling", file=sys.stderr)
        return 2
    mode = sys.argv[1]
    try:
        result = subprocess.run(["windoesnot-hyprctl", "clients", "-j"], capture_output=True, text=True, check=True)
        clients = json.loads(result.stdout)
        monitors = json.loads(subprocess.check_output(["windoesnot-hyprctl", "monitors", "-j"], text=True))
    except (subprocess.CalledProcessError, json.JSONDecodeError) as error:
        print(f"Could not read windows: {error}", file=sys.stderr)
        return 1

    want_floating = mode == "floating"
    targets = [client for client in clients if eligible(client) and bool(client.get("floating", False)) != want_floating]
    dispatcher = "setfloating" if want_floating else "settiled"
    failed = 0
    for client in targets:
        address = client["address"]
        result = subprocess.run(
            ["windoesnot-hyprctl", "dispatch", dispatcher, f"address:{address}"],
            capture_output=True, text=True,
        )
        if result.returncode:
            failed += 1
            print(result.stderr.strip() or f"Could not update {address}", file=sys.stderr)
            continue
        if want_floating:
            geometry = logical_monitor(client, monitors)
            if geometry:
                monitor, mx, my, mw, mh = geometry
                reserved = monitor.get("reserved") or [0, 0, 0, 0]
                # Detached, slightly smaller, centred. Keep titlebar/taskbar visible.
                usable_h = mh - int(reserved[3] if len(reserved) > 3 else 0) - 45
                width = min(round(client["size"][0] * 0.88), round(mw * 0.88))
                height = min(round(client["size"][1] * 0.88), round(usable_h * 0.88))
                x, y = mx + (mw - width) // 2, my + (usable_h - height) // 2 + 30
                subprocess.run(["windoesnot-hyprctl", "--batch",
                    f"dispatch resizewindowpixel exact {width} {height},address:{address}; "
                    f"dispatch movewindowpixel exact {x} {y},address:{address}; "
                    f"dispatch movewindowpixel exact {x} {y},address:{address}"], capture_output=True, text=True)
    print(f"Moved {len(targets) - failed}/{len(targets)} existing window(s) to {mode} mode")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
