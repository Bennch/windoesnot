#!/usr/bin/env python3
"""Release the current normal tiled clients when switching to Floating mode.

This is deliberately a one-shot migration, not a rule: users can still tile
individual windows again afterwards.  Existing client geometry is retained, so
the current arrangement does not collapse into a pile in the screen centre.
"""
import json
import subprocess
import sys


def clients():
    result = subprocess.run(
        ["windoesnot-hyprctl", "clients", "-j"],
        capture_output=True, text=True, check=True,
    )
    return json.loads(result.stdout)


def eligible(client):
    workspace = client.get("workspace") or {}
    return (
        not client.get("floating", False)
        and not client.get("fullscreen", False)
        and not client.get("pinned", False)
        and workspace.get("id", -1) > 0
        and "quickshell" not in (client.get("class") or "").lower()
    )


def main():
    try:
        targets = [client["address"] for client in clients() if eligible(client)]
    except (subprocess.CalledProcessError, json.JSONDecodeError, KeyError) as error:
        print(f"Could not release tiled windows: {error}", file=sys.stderr)
        return 1
    for address in targets:
        result = subprocess.run(
            ["windoesnot-hyprctl", "dispatch", "togglefloating", f"address:{address}"],
            capture_output=True, text=True,
        )
        if result.returncode:
            print(result.stderr.strip() or f"Could not float {address}", file=sys.stderr)
    print(f"Released {len(targets)} tiled window(s) into floating mode")
    return 0


if __name__ == "__main__":
    sys.exit(main())
