#!/usr/bin/env python3
"""List launchers using desktop-entry translations for the selected UI language."""
import configparser
import json
import os
from pathlib import Path
import re
import sys


def search_terms(entry):
    """German and English names, generic names and keywords: typing either language finds the app."""
    terms = set()
    for key, value in entry.items():
        base, _, rest = key.partition('[')
        if base not in ('Name', 'GenericName', 'Keywords'):
            continue
        language = rest.rstrip(']')
        if language and language.split('_')[0] not in ('de', 'en'):
            continue
        for part in (value.split(';') if base == 'Keywords' else [value]):
            part = part.strip()
            if part and not any(c in part for c in '|\n\r'):
                terms.add(part)
    return sorted(terms, key=str.casefold)


# The Start menu grid is for programs people look for. Settings dialogs, system monitors, console tools, debug and driver helpers are
# marked "technical": hidden in the grid, still found by the search, and shown by the "technical apps" toggle.
TECHNICAL_CATEGORIES = {'Settings', 'DesktopSettings', 'HardwareSettings', 'X-GNOME-PersonalSettings', 'X-GNOME-SystemSettings',
                        'X-XFCE-SettingsDialog', 'X-LXDE-Settings', 'X-KDE-settings-system', 'Monitor', 'ConsoleOnly', 'Debugger'}
# WinDoesNot's own apps (settings, device manager, audio, ...) are real programs
OWN_APP_PREFIXES = ('me.windoesnot.', 'windoesnot-')
TECHNICAL_ID_PATTERN = re.compile(
    r'^(electron\d+|jconsole|jshell|yad-|nwg-|qdbusviewer|qv4l2|qvidcap|lstopo|xgps|vamt|vrrtest|vmware-netcfg|hplip|cups\b|gnome-nettool|org\.cachyos\.(KernelManager|scx-manager)|kde4-webapp-manager)'
    r'|(^|[-_.])(uninstall|readme|license|licence|changelog)([-_. ]|$)'
    r'|[-_.](notifier|cachecleaner|repoeditor|settings-daemon|autostart|helper|agent|daemon|netcfg|speedtest|setup|configurator)(\.desktop)?$'
    r'|(^|[-_.])(ColorProfileViewer|extensionmanager|tweaks|tour)(\.desktop)?$', re.IGNORECASE)
TECHNICAL_NAME_PATTERN = re.compile(r'^(uninstall|readme|license|configure|setup)\b|\b(uninstaller|debug|daemon|setup)$|\b(java|openjdk)\b.*\b(console|shell)\b', re.IGNORECASE)


def automatic_technical(identity, entry):
    """True for launchers that are not programs people look for (see above); WinDoesNot's own apps never are."""
    if identity.startswith(OWN_APP_PREFIXES):
        return False
    categories = {c for c in entry.get('Categories', '').split(';') if c}
    if categories & TECHNICAL_CATEGORIES:
        return True
    if entry.get('Terminal', '').lower() == 'true':
        return True
    name = entry.get('Name', '')
    return bool(TECHNICAL_ID_PATTERN.search(identity) or TECHNICAL_NAME_PATTERN.search(name))


def launchers(directories, language, structured=False, technical_ids=()):
    language = language.split('.')[0].replace('-', '_')
    keys = ['Name[' + language + ']', 'Name[' + language.split('_')[0] + ']', 'Name']
    seen = set()
    seen_commands = set()
    result = []
    for directory in directories:
        if not directory.is_dir():
            continue
        for path in sorted(directory.rglob('*.desktop')):
            identity = str(path.relative_to(directory)).replace('/', '-')
            if identity in seen:
                continue
            seen.add(identity)
            parser = configparser.ConfigParser(interpolation=None, strict=False)
            parser.optionxform = str
            try:
                parser.read_string(path.read_text())
                entry = parser['Desktop Entry']
                if entry.get('Type', 'Application') != 'Application' or any(entry.get(k, '').lower() == 'true' for k in ['NoDisplay', 'Hidden']):
                    continue
                name = next((entry[k] for k in keys if entry.get(k)), '')
                command = re.sub(r'\s+%[a-zA-Z](?=\s|$)', '', entry.get('Exec', ''))
                row = (name, command, entry.get('Icon', ''))
                if name and command and all(not any(c in field for c in '|\n\r') for field in row):
                    # Two desktop IDs can launch the same application (for
                    # example webapp-manager in two applications directories).
                    # The first directory has precedence, just as for IDs.
                    if command in seen_commands:
                        continue
                    seen_commands.add(command)
                    names = sorted({value for key, value in entry.items() if key == 'Name' or key.startswith('Name[')})
                    user_data = Path.home() / '.local/share'
                    user_flatpak = Path.home() / '.var/app'
                    is_user_launcher = path.is_relative_to(user_data) or path.is_relative_to(user_flatpak)
                    result.append({'id': identity, 'desktopPath': str(path), 'name': name, 'cmd': command, 'icon': row[2], 'names': names, 'terms': search_terms(entry), 'technical': (identity in technical_ids or automatic_technical(identity, entry)) and (not is_user_launcher or identity.lower().startswith('wine-'))} if structured else '|'.join(row))
            except (OSError, UnicodeError, configparser.Error, KeyError):
                continue
    if structured:
        return sorted(result, key=lambda item: item['name'].casefold())
    return sorted(set(result), key=str.casefold)


def main():
    home = Path.home()
    data_home = Path(os.environ.get('XDG_DATA_HOME', home / '.local/share'))
    directories = [data_home / 'applications']
    directories += [Path(p) / 'applications' for p in os.environ.get('XDG_DATA_DIRS', '/usr/local/share:/usr/share').split(':') if p]
    directories += [home / '.local/share/flatpak/exports/share/applications', Path('/var/lib/flatpak/exports/share/applications')]
    directories += list((home / '.var/app').glob('*/share/applications'))
    directories += list(Path('/snap').glob('*/current/meta/gui'))
    arguments = sys.argv[1:]
    structured = '--json' in arguments
    technical_path = None
    if '--technical-list' in arguments:
        index = arguments.index('--technical-list')
        technical_path = Path(arguments[index + 1]) if index + 1 < len(arguments) else None
        del arguments[index:index + 2]
    arguments = [value for value in arguments if value != '--json']
    technical_ids = set()
    if technical_path and technical_path.is_file():
        technical_ids = {line.strip() for line in technical_path.read_text().splitlines()
                         if line.strip() and not line.lstrip().startswith('#')}
    rows = launchers(directories, arguments[0] if arguments else os.environ.get('LANG', 'en'), structured, technical_ids)
    print(json.dumps(rows, ensure_ascii=False) if structured else '\n'.join(rows))


if __name__ == '__main__':
    main()
