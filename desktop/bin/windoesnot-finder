#!/usr/bin/env python3
"""Finder: looks through a Linux system for everything worth taking along and lets you confirm it.

Reads only. Choose what to take, then save the list or copy it into a home folder.
Same look as the Windows data window (windoesnot-migrate).
"""
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import threading

import gi
gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Adw, Gdk, Gio, GLib, Gtk, Pango

HERE = Path(__file__).resolve().parent
FINDER_PATH = None
for candidate in (Path('/usr/lib/windoesnot'), HERE.parent / 'lib/windoesnot'):
    if (candidate / 'finder.py').is_file():
        sys.path.insert(0, str(candidate))
        FINDER_PATH = candidate / 'finder.py'
        break
import finder  # noqa: E402

GERMAN = (os.environ.get('LANG') or '').startswith('de')
PREVIEW = '--preview' in sys.argv


def tr(de, en): return de if GERMAN else en
def pick(text): return text.get('de' if GERMAN else 'en') or text.get('en') or ''


def size(value):
    if value >= 1 << 30: return f'{value / (1 << 30):.1f} GiB'
    if value >= 1 << 20: return f'{value / (1 << 20):.1f} MiB'
    if value >= 1 << 10: return f'{value / (1 << 10):.0f} KiB'
    return f'{value} B'


CSS = b'''
window, window.background { background: #202020; color: #eeeeee; }
.card, .folder, .card label, .folder label, checkbutton { color: #eeeeee; }
label.wdn-text, label.wdn-heading { color: #eeeeee; }
label.wdn-heading { font-weight: 700; }
.card .dim, .folder .dim { color: #aaaaaa; }
.card { background: #141414; border: 1px solid #3a3a3a; border-radius: 10px; padding: 14px; }
.folder { background: #202020; border: 1px solid #3a3a3a; border-radius: 6px; padding: 8px; }
.warning { background: #382d22; border: 1px solid #b8804b; border-radius: 8px; padding: 10px; color: #f3c99d; }
.error { background: #432a22; border: 1px solid #fe6f2d; border-radius: 8px; padding: 10px; color: #ffd0bc; }
.accent { color: #fe6f2d; }
.dim { color: #aaaaaa; }
.pill { background: #382d22; border: 1px solid #b8804b; border-radius: 99px; padding: 0 8px; font-size: 9pt; color: #f3c99d; }
.pill.soft { background: #202020; border-color: #3a3a3a; color: #aaaaaa; }
checkbutton check { background: #141414; border: 1px solid #777777; color: #202020; }
checkbutton check:checked { background: #fe6f2d; border-color: #fe6f2d; color: #202020; }
progressbar trough { background: #3a3a3a; min-height: 8px; border-radius: 4px; }
progressbar progress { background: #fe6f2d; min-height: 8px; border-radius: 4px; }
button.suggested-action { background: #fe6f2d; color: #202020; }
'''


def open_path(path):
    """Open a folder (or the folder of a file) in the file manager so the user can look inside."""
    target = Path(path)
    if target.is_file() or (target.exists() and not target.is_dir()):
        target = target.parent
    try:
        Gio.AppInfo.launch_default_for_uri(target.as_uri(), None)
    except GLib.Error:
        subprocess.Popen(['xdg-open', str(target)], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title=tr('Mitnehmen', 'Take along'), default_width=860, default_height=780)
        self.manifest = None
        self.target = None
        self.order = []          # page names in step order
        self.titles = {}
        self.current = 'start'
        self.pulse = None
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=18, margin_bottom=18, margin_start=24, margin_end=24)
        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(Adw.HeaderBar())
        toolbar.set_content(outer)
        self.set_content(toolbar)
        self.step_label = Gtk.Label(xalign=0)
        self.step_label.add_css_class('accent')
        outer.append(self.step_label)
        self.step_progress = Gtk.ProgressBar()
        outer.append(self.step_progress)
        self.heading = Gtk.Label(xalign=0, wrap=True)
        self.heading.add_css_class('title-2'); self.heading.add_css_class('wdn-heading')
        outer.append(self.heading)
        self.status = Gtk.Label(xalign=0, wrap=True)
        outer.append(self.status)
        self.stack = Gtk.Stack(vexpand=True, transition_type=Gtk.StackTransitionType.SLIDE_LEFT_RIGHT, transition_duration=180)
        outer.append(self.stack)
        nav = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.back = Gtk.Button(label=tr('Zurück', 'Back'))
        self.back.connect('clicked', lambda *_: self.go(-1))
        self.total = Gtk.Label(xalign=0.5, hexpand=True)
        self.total.add_css_class('accent')
        self.next = Gtk.Button(label=tr('Weiter', 'Next'))
        self.next.add_css_class('suggested-action')
        self.next.connect('clicked', lambda *_: self.go(1))
        nav.append(self.back); nav.append(self.total); nav.append(self.next)
        outer.append(nav)
        self.add_page('start', tr('Was möchtest du mitnehmen?', 'What do you want to take along?'), self.start_page())
        self.add_page('scan', tr('Ich sehe nach …', 'Looking …'), self.scan_page())
        self.order = ['start']
        self.show_page('start')
        if PREVIEW:
            path = next((a.split('=', 1)[1] for a in sys.argv if a.startswith('--manifest=')), None)
            if path:
                self.show_result(json.loads(Path(path).read_text()))

    # --- pages ----------------------------------------------------------------------------------------
    def add_page(self, name, title, widget):
        self.titles[name] = title
        self.stack.add_named(widget, name)

    def start_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        intro = Gtk.Label(label=tr('Ich sehe das System durch und finde Profile, Passwörter, Schlüssel, Einstellungen, Projekte und große Daten. '
                                   'Danach gehst du Schritt für Schritt durch die Funde und bestätigst, was mitkommt. Das alte System bleibt unverändert.',
                                   'I look through the system and find profiles, passwords, keys, settings, projects and large data. '
                                   'Then you go through the findings step by step and confirm what comes along. The old system stays unchanged.'), xalign=0, wrap=True)
        intro.add_css_class('dim'); page.append(intro)
        for label, handler, style in ((tr('Dieses System durchsuchen', 'Search this system'), lambda *_: self.begin(Path('/')), 'suggested-action'),
                                      (tr('Anderes (eingehängtes) System wählen …', 'Choose another (mounted) system …'), self.choose_root, None),
                                      (tr('Gespeicherte Liste öffnen …', 'Open a saved list …'), self.open_manifest, None)):
            card = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            card.add_css_class('card')
            button = Gtk.Button(label=label, hexpand=True)
            if style: button.add_css_class(style)
            button.connect('clicked', handler)
            card.append(button)
            page.append(card)
        return page

    def scan_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, valign=Gtk.Align.CENTER)
        self.scan_label = Gtk.Label(label='', wrap=True)
        self.scan_label.add_css_class('dim')
        spinner = Gtk.Spinner(spinning=True, width_request=40, height_request=40)
        page.append(spinner); page.append(self.scan_label)
        return page

    def show_page(self, name):
        if name in self.order:
            index = self.order.index(name)
            self.step_label.set_text(tr(f'Schritt {index + 1} von {len(self.order)}', f'Step {index + 1} of {len(self.order)}') if len(self.order) > 1 else '')
            self.step_progress.set_fraction((index + 1) / len(self.order) if len(self.order) > 1 else 0)
        self.current = name
        self.heading.set_text(self.titles.get(name, ''))
        self.stack.set_visible_child_name(name)
        self.update_nav()

    def update_nav(self):
        index = self.order.index(self.current) if self.current in self.order else 0
        on_start, scanning = self.current == 'start', self.current == 'scan'
        self.back.set_visible(not (on_start or scanning) and index > 0)
        self.next.set_visible(not (on_start or scanning))
        last = self.current == 'copy'
        self.next.set_visible(not on_start and not scanning and not last)
        if self.current == 'overview':
            self.next.set_label(tr('Mitnehmen …', 'Take along …'))
        else:
            self.next.set_label(tr('Weiter', 'Next'))
        selected = [f for f in (self.manifest or {}).get('findings', []) if f.get('selected')]
        need = sum(f['bytes'] for f in selected)
        self.total.set_text('' if not self.manifest or on_start or scanning else tr(f'{len(selected)} ausgewählt · {size(need)}', f'{len(selected)} selected · {size(need)}'))
        if self.current == 'overview':
            self.next.set_sensitive(bool(selected))
        else:
            self.next.set_sensitive(True)

    def go(self, delta):
        if self.current == 'overview' and delta > 0:
            self.choose_target()
            return
        index = self.order.index(self.current) + delta
        if 0 <= index < len(self.order):
            self.show_page(self.order[index])

    def message(self, value, style='warning'):
        self.status.set_text(value)
        for css in ('warning', 'error', 'dim'):
            self.status.remove_css_class(css)
        if value: self.status.add_css_class(style)

    # --- scanning -------------------------------------------------------------------------------------
    def begin(self, root):
        self.message('')
        self.manifest = None
        self.order = ['start', 'scan']
        self.show_page('scan')
        self.step_label.set_text(''); self.step_progress.set_fraction(0)
        self.pulse = GLib.timeout_add(120, lambda: (self.step_progress.pulse(), True)[1])
        threading.Thread(target=self.scan_worker, args=(root,), daemon=True).start()
        return False

    def scan_worker(self, root):
        def progress(text):
            GLib.idle_add(self.scan_label.set_label, tr('Ich sehe nach: ', 'Looking at: ') + text)
        try:
            manifest = finder.scan(root, None, progress)
        except (OSError, ValueError) as error:
            GLib.idle_add(self.scan_failed, str(error))
            return
        GLib.idle_add(self.show_result, manifest)

    def stop_pulse(self):
        if self.pulse:
            GLib.source_remove(self.pulse); self.pulse = None

    def scan_failed(self, message):
        self.stop_pulse()
        self.order = ['start']
        self.show_page('start')
        self.message(message or tr('Nichts gefunden.', 'Nothing found.'), 'error')

    def choose_root(self, *_):
        dialog = Gtk.FileDialog(title=tr('Wurzelordner des alten Systems', 'Root folder of the old system'))
        dialog.select_folder(self, None, self.root_chosen)

    def root_chosen(self, dialog, result):
        try:
            folder = dialog.select_folder_finish(result)
        except GLib.Error:
            return
        self.begin(Path(folder.get_path()))

    def open_manifest(self, *_):
        dialog = Gtk.FileDialog(title=tr('Gespeicherte Liste', 'Saved list'))
        dialog.open(self, None, self.manifest_opened)

    def manifest_opened(self, dialog, result):
        try:
            path = dialog.open_finish(result).get_path()
            manifest = json.loads(Path(path).read_text())
            if manifest.get('schema') != finder.SCHEMA or manifest.get('kind') != 'finder':
                raise ValueError(tr('Das ist keine Liste dieser Anwendung.', 'This is not a list of this application.'))
        except GLib.Error:
            return
        except (OSError, ValueError) as error:
            self.message(str(error), 'error'); return
        self.show_result(manifest)

    # --- one step per group ---------------------------------------------------------------------------
    def show_result(self, manifest):
        self.stop_pulse()
        self.manifest = manifest
        for name in list(self.order):
            if name not in ('start', 'scan'):
                child = self.stack.get_child_by_name(name)
                if child: self.stack.remove(child)
        findings = manifest['findings']
        names = ['start']
        self.message(tr(f'{len(findings)} Funde bei {manifest["user"]["name"]}. Haken gesetzt = kommt mit. Neu Ladbares ist abgewählt.',
                        f'{len(findings)} findings for {manifest["user"]["name"]}. Ticked = comes along. Rebuildable things are unticked.'), 'dim')
        for group in manifest['groups']:
            items = [f for f in findings if f['group'] == group['id']]
            if not items:
                continue
            name = 'group:' + group['id']
            self.add_page(name, pick(group['title']), self.group_page(group, items))
            names.append(name)
        self.add_page('overview', tr('Überblick', 'Overview'), self.overview_page())
        self.add_page('copy', tr('Ich nehme es mit', 'Taking it along'), self.copy_page())
        self.order = names + ['overview', 'copy']
        self.show_page(names[1] if len(names) > 1 else 'overview')

    def group_page(self, group, items):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        head = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        total = Gtk.Label(label=tr(f'{len(items)} Funde · {size(sum(i["bytes"] for i in items))}', f'{len(items)} findings · {size(sum(i["bytes"] for i in items))}'), xalign=0, hexpand=True)
        total.add_css_class('dim')
        head.append(total)
        checks = []
        for text, value in ((tr('alle', 'all'), True), (tr('keine', 'none'), False)):
            button = Gtk.Button(label=text)
            button.add_css_class('flat')
            button.connect('clicked', lambda _b, v=value, cs=checks: [c.set_active(v) for c in cs])
            head.append(button)
        page.append(head)
        scroll = Gtk.ScrolledWindow(vexpand=True)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        scroll.set_child(box)
        for item in items:
            checks.append(self.finding_row(box, item))
        page.append(scroll)
        return page

    def absolute(self, item, rel):
        root = Path(self.manifest['source_root'])
        if rel.startswith('/'):
            return root / rel.lstrip('/')
        return root / self.manifest['user']['home'].lstrip('/') / rel

    def finding_row(self, box, item):
        row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        row.add_css_class('folder'); box.append(row)
        line = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        row.append(line)
        check = Gtk.CheckButton()
        check.set_active(bool(item.get('selected')))
        check.connect('toggled', lambda button, entry=item: (entry.__setitem__('selected', button.get_active()), self.update_nav()))
        line.append(check)
        name = Gtk.Label(label=pick(item['title']), xalign=0, hexpand=True)
        name.add_css_class('wdn-text')
        click = Gtk.GestureClick()
        click.connect('released', lambda *_a, button=check: button.set_active(not button.get_active()))
        name.add_controller(click)
        line.append(name)
        if item.get('secrets'):
            pill = Gtk.Label(label=tr('Zugangsdaten', 'Credentials')); pill.add_css_class('pill')
            pill.set_tooltip_text(tr('Enthält Passwörter, Schlüssel oder Anmeldungen. Bewahre die Kopie sicher auf.', 'Contains passwords, keys or logins. Keep the copy safe.'))
            line.append(pill)
        if item['group'] == 'rebuildable':
            pill = Gtk.Label(label=tr('neu ladbar', 'rebuildable')); pill.add_css_class('pill'); pill.add_css_class('soft'); line.append(pill)
        if item.get('note') == 'foreign-desktop':
            pill = Gtk.Label(label=tr('teils andere Oberfläche', 'partly another desktop')); pill.add_css_class('pill'); pill.add_css_class('soft')
            pill.set_tooltip_text(tr('KDE- oder GNOME-Einstellungen gelten in Hyprland nicht, schaden aber nicht.', 'KDE or GNOME settings do not apply in Hyprland but do no harm.'))
            line.append(pill)
        if 'needs_admin' in item.get('warnings', []):
            pill = Gtk.Label(label=tr('Administrator nötig', 'needs administrator')); pill.add_css_class('pill')
            pill.set_tooltip_text(tr('Nur der Administrator darf diesen Ordner lesen; die Größe ist unbekannt.', 'Only the administrator may read this folder; the size is unknown.'))
            line.append(pill)
        amount = Gtk.Label(label=size(item['bytes']) if item['bytes'] else '?'); amount.add_css_class('dim')
        amount.set_width_chars(10); amount.set_xalign(1)
        line.append(amount)
        detail = Gtk.Label(label=pick(item['detail']), xalign=0, wrap=True, margin_start=28)
        detail.add_css_class('dim')
        row.append(detail)
        # Look inside: every path can be opened in the file manager.
        expander = Gtk.Expander(label=tr(f'Orte ansehen ({len(item["paths"])})', f'Show locations ({len(item["paths"])})'), margin_start=28)
        paths = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        for rel in item['paths'][:60]:
            entry = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            label = Gtk.Label(label=rel, xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.MIDDLE)
            label.add_css_class('dim')
            opener = Gtk.Button(label=tr('Öffnen', 'Open'))
            opener.add_css_class('flat')
            opener.connect('clicked', lambda _b, r=rel: open_path(self.absolute(item, r)))
            entry.append(label); entry.append(opener)
            paths.append(entry)
        if len(item['paths']) > 60:
            more = Gtk.Label(label=tr(f'… und {len(item["paths"]) - 60} weitere', f'… and {len(item["paths"]) - 60} more'), xalign=0)
            more.add_css_class('dim'); paths.append(more)
        expander.set_child(paths)
        row.append(expander)
        return check

    # --- overview, saving, copying --------------------------------------------------------------------
    def overview_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        summary = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        summary.add_css_class('card'); page.append(summary)
        self.sum_total = Gtk.Label(xalign=0); self.sum_total.add_css_class('accent'); summary.append(self.sum_total)
        self.sum_free = Gtk.Label(xalign=1, hexpand=True); self.sum_free.add_css_class('dim'); summary.append(self.sum_free)
        scroll = Gtk.ScrolledWindow(vexpand=True)
        self.overview_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        scroll.set_child(self.overview_box)
        page.append(scroll)
        save = Gtk.Button(label=tr('Liste speichern …', 'Save list …'))
        save.connect('clicked', self.save_manifest)
        page.append(save)
        self.stack.connect('notify::visible-child-name', lambda *_: self.refresh_overview() if self.current == 'overview' else None)
        return page

    def refresh_overview(self):
        while child := self.overview_box.get_first_child(): self.overview_box.remove(child)
        selected = [f for f in self.manifest['findings'] if f.get('selected')]
        need = sum(f['bytes'] for f in selected)
        self.sum_total.set_text(tr(f'{len(selected)} ausgewählt · {size(need)}', f'{len(selected)} selected · {size(need)}'))
        try:
            st = os.statvfs(Path.home())
            self.sum_free.set_text(tr('Frei im Home: ', 'Free in home: ') + size(st.f_bavail * st.f_frsize))
        except OSError:
            self.sum_free.set_text('')
        for group in self.manifest['groups']:
            items = [f for f in selected if f['group'] == group['id']]
            if not items:
                continue
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            card.add_css_class('card'); self.overview_box.append(card)
            heading = Gtk.Label(label=pick(group['title']) + '   ·   ' + size(sum(i['bytes'] for i in items)), xalign=0)
            heading.add_css_class('title-3'); heading.add_css_class('wdn-heading'); card.append(heading)
            for item in items:
                text = Gtk.Label(label=pick(item['title']) + ' · ' + size(item['bytes']), xalign=0, wrap=True)
                text.add_css_class('dim'); card.append(text)
        if any(f.get('secrets') for f in selected):
            note = Gtk.Label(label=tr('Die Auswahl enthält Zugangsdaten. Bewahre die Kopie sicher auf und verschlüssele sie, wenn sie auf einem Speicher liegt, den andere erreichen.',
                                      'The selection contains credentials. Keep the copy safe and encrypt it if it lies on storage others can reach.'), xalign=0, wrap=True)
            note.add_css_class('warning'); self.overview_box.append(note)
        self.update_nav()

    def copy_page(self):
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, valign=Gtk.Align.CENTER)
        self.copy_bar = Gtk.ProgressBar()
        self.copy_label = Gtk.Label(label='', wrap=True)
        self.copy_label.add_css_class('dim')
        page.append(self.copy_bar); page.append(self.copy_label)
        return page

    def save_manifest(self, *_):
        dialog = Gtk.FileDialog(title=tr('Liste speichern', 'Save list'), initial_name='mitnehmen.json')
        dialog.save(self, None, self.manifest_saved)

    def manifest_saved(self, dialog, result):
        try:
            path = dialog.save_finish(result).get_path()
        except GLib.Error:
            return
        Path(path).write_text(json.dumps(self.manifest, ensure_ascii=False, indent=1))
        self.message(tr('Liste gespeichert: ', 'List saved: ') + path, 'dim')

    def choose_target(self):
        dialog = Gtk.FileDialog(title=tr('Ziel: Home-Ordner des neuen Systems', 'Target: home folder of the new system'))
        dialog.select_folder(self, None, self.target_chosen)

    def target_chosen(self, dialog, result):
        try:
            target = dialog.select_folder_finish(result).get_path()
        except GLib.Error:
            return
        if Path(target).resolve() == self.absolute(None, self.manifest['user']['home']).resolve():
            self.message(tr('Quelle und Ziel sind derselbe Ordner.', 'Source and target are the same folder.'), 'error'); return
        st = os.statvfs(target)
        free = st.f_bavail * st.f_frsize
        need = sum(f['bytes'] for f in self.manifest['findings'] if f.get('selected'))
        if need > free:
            self.message(tr(f'Dort ist zu wenig Platz: {size(need)} nötig, {size(free)} frei. Wähle weniger aus oder ein anderes Ziel.',
                            f'Not enough space there: {size(need)} needed, {size(free)} free. Choose less or another target.'), 'error'); return
        self.message('')
        self.copy_bar.set_fraction(0)
        self.copy_label.set_text('')
        self.show_page('copy')
        threading.Thread(target=self.copy_worker, args=(target, need), daemon=True).start()

    def copy_worker(self, target, need):
        needs_root = any(f.get('selected') and f.get('note') == 'absolute' for f in self.manifest['findings'])
        with tempfile.NamedTemporaryFile('w', suffix='.json', delete=False) as handle:
            json.dump(self.manifest, handle)
            path = handle.name
        command = [sys.executable, str(FINDER_PATH), 'copy', path, target]
        if needs_root and os.geteuid() != 0:
            command = ['pkexec'] + command
        done, result, error = 0, None, ''
        try:
            proc = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            for line in proc.stdout:
                try:
                    event = json.loads(line)
                except ValueError:
                    continue
                if event.get('event') == 'finding':
                    done += event['bytes']
                    label = next((pick(f['title']) for f in self.manifest['findings'] if f['id'] == event['id']), '')
                    GLib.idle_add(self.copy_progress, min(1.0, done / max(1, need)), label)
                elif 'copied' in event:
                    result = event
            proc.wait()
            error = proc.stderr.read().strip()
        finally:
            os.unlink(path)
        GLib.idle_add(self.copy_finished, result, error)

    def copy_progress(self, fraction, label):
        self.copy_bar.set_fraction(fraction)
        self.copy_label.set_text(tr('Ich kopiere: ', 'Copying: ') + label)

    def copy_finished(self, result, error):
        if result is None:
            self.copy_label.set_text(error or tr('Das hat nicht geklappt.', 'That did not work.'))
            self.back.set_visible(True)
            return
        self.copy_bar.set_fraction(1)
        problems = result.get('problems', [])
        text = tr(f'Fertig: {len(result["copied"])} Funde kopiert.', f'Done: {len(result["copied"])} findings copied.')
        if problems:
            text += ' ' + tr(f'{len(problems)} Pfade mit Problemen: ', f'{len(problems)} paths with problems: ') + ', '.join(p['path'] for p in problems[:5])
        self.copy_label.set_text(text)


class App(Adw.Application):
    def __init__(self): super().__init__(application_id='me.windoesnot.Finder')
    def do_activate(self):
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        provider = Gtk.CssProvider(); provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.window = Window(self)
        self.window.present()


if __name__ == '__main__':
    raise SystemExit(App().run([sys.argv[0]]))
