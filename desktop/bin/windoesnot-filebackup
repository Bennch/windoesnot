#!/usr/bin/env python3
"""File backup to an external drive or network share (see windoesnot/filebackup.py). Every command prints JSON."""
import json
import sys
from pathlib import Path

for lib in (Path(__file__).resolve().parent.parent / 'lib/windoesnot', Path('/usr/lib/windoesnot')):
    sys.path.insert(0, str(lib))
import filebackup as fb


def out(value):
    print(json.dumps(value, ensure_ascii=False))


def main(argv):
    if not argv or argv[0] in ('-h', '--help'):
        print('usage: windoesnot-filebackup status|drives|config [json]|run|daemon|list|browse ID [PATH]|restore ID PATH [DEST]|delete ID|prune')
        return 0
    command, rest = argv[0], argv[1:]
    try:
        if command == 'status':
            out(fb.status_report())
        elif command == 'drives':
            out(fb.list_drives())
        elif command == 'config':
            if rest:
                config = fb.load_config()
                config.update({k: v for k, v in json.loads(rest[0]).items() if k in fb.DEFAULTS and k != 'version'})
                fb.save_config(fb.validate_config(config))
            out(fb.load_config())
        elif command == 'run':
            out(fb.run_backup())
        elif command == 'daemon':
            fb.daemon(once='--once' in rest)
        elif command in ('list', 'browse', 'restore', 'delete', 'prune'):
            base, _ = fb.resolve_target(fb.load_config()['target'])
            if command == 'list':
                out(fb.list_snapshots(base))
            elif command == 'browse':
                out(fb.browse(base, rest[0], rest[1] if len(rest) > 1 else ''))
            elif command == 'restore':
                out({'restored': fb.restore(base, rest[0], rest[1], rest[2] if len(rest) > 2 else None)})
            elif command == 'delete':
                fb.delete_snapshot(base, rest[0]); out({'ok': True})
            else:
                out({'removed': fb.prune(base, fb.load_config()['keep'])})
        else:
            print('unknown command', file=sys.stderr)
            return 2
    except fb.BackupError as error:
        out({'error': str(error)})
        return 1
    return 0


sys.exit(main(sys.argv[1:]))
