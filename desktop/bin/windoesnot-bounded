#!/usr/bin/env python3
"""Run a command with a hard deadline, killing its whole process group."""
import os
import signal
import subprocess
import sys


def main():
    if len(sys.argv) < 3:
        print("usage: windoesnot-bounded SECONDS COMMAND [ARG ...]", file=sys.stderr)
        return 2
    try:
        seconds = float(sys.argv[1])
        if seconds <= 0:
            raise ValueError
    except ValueError:
        print("SECONDS must be positive", file=sys.stderr)
        return 2
    proc = subprocess.Popen(sys.argv[2:], start_new_session=True)
    try:
        return proc.wait(timeout=seconds)
    except subprocess.TimeoutExpired:
        try:
            os.killpg(proc.pid, signal.SIGTERM)
        except ProcessLookupError:
            pass
        try:
            proc.wait(timeout=1)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(proc.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            proc.wait()
        return 124


if __name__ == "__main__":
    raise SystemExit(main())
