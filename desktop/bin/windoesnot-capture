#!/usr/bin/env python3
"""Snipping tool and screen recorder. With an argument (region|window|screen|record-toggle) it runs without a window."""
import os
from pathlib import Path
import subprocess
import sys
import threading
import time

LIB = Path('/usr/lib/windoesnot')
if not (LIB / 'capture.py').is_file():
    LIB = Path(__file__).resolve().parent.parent / 'lib/windoesnot'
sys.path.insert(0, str(LIB))
import capture

if len(sys.argv) > 1:
    raise SystemExit(capture.main(sys.argv[1:]))

import gi
gi.require_version('Gtk', '4.0')
gi.require_version('Adw', '1')
from gi.repository import Adw, GLib, Gtk, Gdk

GERMAN = (os.environ.get('LANG') or '').startswith('de')
def tr(de, en): return de if GERMAN else en

CSS = b'''
window, window.background { background: #202020; color: #eeeeee; }
label, checkbutton { color: #eeeeee; }
.dim { color: #aaaaaa; }
.error { background: #432a22; border: 1px solid #fe6f2d; border-radius: 8px; padding: 10px; color: #ffd0bc; }
checkbutton check { background: #141414; border: 1px solid #777777; color: #202020; }
checkbutton check:checked { background: #fe6f2d; border-color: #fe6f2d; color: #202020; }
button.suggested-action { background: #fe6f2d; color: #202020; }
button.destructive-action { background: #c0392b; color: #ffffff; }
'''

class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title=tr('Bildschirmaufnahme', 'Capture'), default_width=420, default_height=360)
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=18, margin_bottom=18, margin_start=24, margin_end=24)
        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(Adw.HeaderBar())
        toolbar.set_content(outer)
        self.set_content(toolbar)
        modes = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8, homogeneous=True)
        for mode, label in [('region', tr('Bereich', 'Region')), ('window', tr('Fenster', 'Window')), ('screen', tr('Bildschirm', 'Screen'))]:
            button = Gtk.Button(label=label)
            button.add_css_class('suggested-action')
            button.connect('clicked', self.shoot, mode)
            modes.append(button)
        outer.append(modes)
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        row.append(Gtk.Label(label=tr('Verzögerung', 'Delay'), xalign=0, hexpand=True))
        self.delay = Gtk.DropDown.new_from_strings([tr('Keine', 'None')] + [f'{n} s' for n in capture.DELAYS[1:]])
        row.append(self.delay)
        outer.append(row)
        self.copy_check = Gtk.CheckButton(label=tr('In die Zwischenablage kopieren', 'Copy to clipboard'))
        self.copy_check.set_active(True)
        outer.append(self.copy_check)
        self.region_check = Gtk.CheckButton(label=tr('Aufnahme: nur Bereich', 'Recording: region only'))
        outer.append(self.region_check)
        self.audio_check = Gtk.CheckButton(label=tr('Aufnahme mit Ton', 'Record with audio'))
        outer.append(self.audio_check)
        self.record_button = Gtk.Button()
        self.record_button.connect('clicked', self.toggle_record)
        outer.append(self.record_button)
        folders = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8, homogeneous=True)
        for label, getter in [(tr('Bilder-Ordner', 'Show screenshots'), capture.screenshot_dir), (tr('Aufnahmen-Ordner', 'Show recordings'), capture.recording_dir)]:
            button = Gtk.Button(label=label)
            button.connect('clicked', self.show_folder, getter)
            folders.append(button)
        outer.append(folders)
        self.status = Gtk.Label(xalign=0, wrap=True)
        outer.append(self.status)
        self.refresh_record()
        GLib.timeout_add_seconds(2, self.refresh_record)

    def message(self, value, style=None):
        self.status.set_text(value)
        self.status.remove_css_class('error')
        if value and style: self.status.add_css_class(style)

    def refresh_record(self):
        running = capture.is_recording()
        self.record_button.set_label(tr('Aufnahme beenden', 'Stop recording') if running else tr('Aufnahme starten', 'Start recording'))
        self.record_button.remove_css_class('suggested-action' if running else 'destructive-action')
        self.record_button.add_css_class('destructive-action' if running else 'suggested-action')
        return True

    def run_job(self, job, done, hide=False):
        if hide: self.set_visible(False)
        def work():
            try:
                if hide: time.sleep(0.4)
                result, error = job(), None
            except (capture.CaptureError, OSError, subprocess.SubprocessError) as exc:
                result, error = None, str(exc)
            GLib.idle_add(done, result, error)
        threading.Thread(target=work, daemon=True).start()

    def shoot(self, _button, mode):
        delay = capture.DELAYS[self.delay.get_selected()]
        copy = self.copy_check.get_active()
        self.message(tr('Bitte warten …', 'Please wait …'))
        def done(path, error):
            self.set_visible(True)
            self.message(error or (str(path) if path else ''), 'error' if error else None)
            return False
        self.run_job(lambda: capture.take_screenshot(mode, delay=delay, clipboard=copy), done, hide=True)

    def toggle_record(self, *_):
        region, audio = self.region_check.get_active(), self.audio_check.get_active()
        def done(result, error):
            self.refresh_record()
            self.message(error or (str(result[1]) if result and result[1] else ''), 'error' if error else None)
            return False
        self.run_job(lambda: capture.toggle_recording(region=region, audio=audio), done)

    def show_folder(self, _button, getter):
        folder = getter()
        folder.mkdir(parents=True, exist_ok=True)
        subprocess.Popen(['xdg-open', str(folder)], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)

class App(Adw.Application):
    def __init__(self): super().__init__(application_id='me.windoesnot.Capture')
    def do_activate(self):
        Adw.StyleManager.get_default().set_color_scheme(Adw.ColorScheme.FORCE_DARK)
        provider = Gtk.CssProvider(); provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        self.window = Window(self)
        self.window.present()

if __name__ == '__main__':
    raise SystemExit(App().run(sys.argv))
