#!/usr/bin/env python3
"""Snipping tool and screen recorder. No argument: the capture overlay (Quickshell). See capture.py for the commands."""
from pathlib import Path
import sys

LIB = Path('/usr/lib/windoesnot')
if not (LIB / 'capture.py').is_file():
    LIB = Path(__file__).resolve().parent.parent / 'lib/windoesnot'
sys.path.insert(0, str(LIB))
import capture

raise SystemExit(capture.main(sys.argv[1:] or ['overlay']))
