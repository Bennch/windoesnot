#!/usr/bin/env python3
"""Rebuild installed Hyprland plugins after a pacman transaction."""
import hashlib
import ctypes
import logging
import os
from pathlib import Path
import pwd
import shutil
import subprocess
import sys
import tempfile

ROOT = Path(os.environ.get('WDN_REBUILD_TEST_ROOT', '/'))
SOURCE = ROOT / 'usr/share/windoesnot/plugins-src'
TARGET = ROOT / 'usr/lib/windoesnot/plugins'
MARKER = ROOT / 'var/lib/windoesnot/plugins-built-for'
LOG = ROOT / 'var/log/windoesnot-plugins-rebuild.log'
COMPONENT_SOURCE = ROOT / 'usr/share/windoesnot/components-src/terminalmodule'
COMPONENT_TARGET = ROOT / 'usr/lib/windoesnot/LocalTerminal'
COMPONENT_MARKER = ROOT / 'var/lib/windoesnot/components-built-for'
NAMES = ('hyprbars', 'hyprdrag')
CFLAGS = '-march=x86-64 -mtune=generic -O2 -pipe -fno-plt -fexceptions -Wp,-D_FORTIFY_SOURCE=3 -Wformat -Werror=format-security -fstack-clash-protection -fcf-protection'


def run(*args, **kwargs):
    return subprocess.run(args, check=True, **kwargs)


def fingerprint():
    versions = run('pacman', '-Q', 'hyprland', 'libstdc++', capture_output=True, text=True).stdout
    digest = hashlib.sha256()
    for name in NAMES:
        for path in sorted((SOURCE / name).rglob('*')):
            if path.is_file():
                digest.update(path.relative_to(SOURCE).as_posix().encode())
                digest.update(path.read_bytes())
    digest.update((SOURCE / 'check-plugin-symbols.py').read_bytes())
    return versions + 'sources sha256 ' + digest.hexdigest() + '\n'


def notify_failure(component):
    try:
        locale = (ROOT / 'etc/locale.conf').read_text()
    except OSError:
        locale = ''
    german = any(line.startswith('LANG=de') for line in locale.splitlines())
    if component == 'terminal':
        message = ('Das eingebettete Terminal konnte nach dem Qt-Update nicht neu gebaut werden' if german else
                   'The embedded terminal could not be rebuilt after the Qt update')
    else:
        message = ('Fensterleisten konnten nach dem Hyprland-Update nicht neu gebaut werden' if german else
                   'Window title bars could not be rebuilt after the Hyprland update')
    runtime = ROOT / 'run/user'
    if not runtime.exists():
        return
    for user_dir in runtime.iterdir():
        if not user_dir.name.isdecimal() or not (user_dir / 'bus').exists():
            continue
        uid = int(user_dir.name)
        try:
            user = pwd.getpwuid(uid).pw_name
            run('runuser', '-u', user, '--', 'env',
                f'XDG_RUNTIME_DIR=/run/user/{uid}',
                f'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/{uid}/bus',
                'notify-send', 'WinDoesNot', message, timeout=10,
                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        except (KeyError, OSError, subprocess.CalledProcessError):
            logging.exception('Could not notify UID %s', uid)


def rebuild():
    if os.geteuid() != 0 and 'WDN_REBUILD_TEST_ROOT' not in os.environ:
        raise PermissionError('Run as root')
    expected = fingerprint()
    if MARKER.exists() and MARKER.read_text() == expected and all((TARGET / f'{n}.so').is_file() for n in NAMES):
        logging.info('Already current')
        return
    run('pkg-config', '--exists', 'hyprland')
    TARGET.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix='windoesnot-plugins-') as temp:
        work = Path(temp)
        env = os.environ.copy()
        env['CFLAGS'] = CFLAGS
        env['CXXFLAGS'] = CFLAGS + ' -Wp,-D_GLIBCXX_ASSERTIONS'
        for name in NAMES:
            shutil.copytree(SOURCE / name, work / name)
            run('make', '-C', str(work / name), '-j', str(os.cpu_count() or 1), 'CXX=g++', env=env)
            so = work / name / f'{name}.so'
            if not so.is_file() or not so.stat().st_size:
                raise RuntimeError(f'Missing build result: {name}')
            run(sys.executable, str(SOURCE / 'check-plugin-symbols.py'), str(so), env=env)
        # Stage both binaries on the target filesystem before touching either original.
        staged = []
        backups = {}
        replaced = []
        try:
            for name in NAMES:
                destination = TARGET / f'{name}.so'
                fd, path = tempfile.mkstemp(prefix=f'.{name}.', dir=TARGET)
                with os.fdopen(fd, 'wb') as output, (work / name / f'{name}.so').open('rb') as source:
                    shutil.copyfileobj(source, output)
                    output.flush()
                    os.fsync(output.fileno())
                os.chmod(path, 0o755)
                staged.append((Path(path), destination))
                if destination.exists():
                    backups[destination] = destination.read_bytes()
            for source, destination in staged:
                os.replace(source, destination)
                replaced.append(destination)
                if 'WDN_REBUILD_TEST_ROOT' in os.environ and os.environ.get('WDN_REBUILD_TEST_FAIL_AFTER_FIRST_REPLACE') and len(replaced) == 1:
                    raise RuntimeError('Injected replacement failure')
            MARKER.parent.mkdir(parents=True, exist_ok=True)
            fd, path = tempfile.mkstemp(prefix='.plugins-built-for.', dir=MARKER.parent)
            try:
                with os.fdopen(fd, 'w') as output:
                    output.write(expected)
                    output.flush()
                    os.fsync(output.fileno())
                os.replace(path, MARKER)
            finally:
                Path(path).unlink(missing_ok=True)
        except Exception:
            for destination in reversed(replaced):
                if destination in backups:
                    fd, path = tempfile.mkstemp(prefix='.restore.', dir=TARGET)
                    with os.fdopen(fd, 'wb') as output:
                        output.write(backups[destination])
                    os.chmod(path, 0o755)
                    os.replace(path, destination)
                else:
                    destination.unlink(missing_ok=True)
            raise
        finally:
            for source, _ in staged:
                source.unlink(missing_ok=True)
    logging.info('Rebuilt plugins for %s', expected.splitlines()[:2])


def component_fingerprint():
    versions = run('pacman', '-Q', 'qt6-base', 'qtermwidget', 'qt6-declarative',
                   capture_output=True, text=True).stdout
    digest = hashlib.sha256()
    for path in sorted(COMPONENT_SOURCE.rglob('*')):
        if path.is_file():
            digest.update(path.relative_to(COMPONENT_SOURCE).as_posix().encode())
            digest.update(path.read_bytes())
    return versions + 'sources sha256 ' + digest.hexdigest() + '\n'


def exchange_directories(first, second):
    # Linux renameat2 exchanges nonempty directories in one filesystem operation.
    result = ctypes.CDLL(None, use_errno=True).renameat2(
        -100, os.fsencode(first), -100, os.fsencode(second), 2)
    if result != 0:
        error = ctypes.get_errno()
        raise OSError(error, os.strerror(error))


def write_marker(marker, content):
    marker.parent.mkdir(parents=True, exist_ok=True)
    fd, path = tempfile.mkstemp(prefix=f'.{marker.name}.', dir=marker.parent)
    try:
        with os.fdopen(fd, 'w') as output:
            output.write(content)
            output.flush()
            os.fsync(output.fileno())
        os.replace(path, marker)
    finally:
        Path(path).unlink(missing_ok=True)


def rebuild_components():
    if os.geteuid() != 0 and 'WDN_REBUILD_TEST_ROOT' not in os.environ:
        raise PermissionError('Run as root')
    expected = component_fingerprint()
    required = ('qmldir', 'liblocalterminalplugin.so', 'liblocalterminalpluginplugin.so')
    if (COMPONENT_MARKER.exists() and COMPONENT_MARKER.read_text() == expected and
            all((COMPONENT_TARGET / name).is_file() for name in required)):
        logging.info('Terminal already current')
        return
    env = os.environ.copy()
    env['CFLAGS'] = CFLAGS
    env['CXXFLAGS'] = CFLAGS + ' -Wp,-D_GLIBCXX_ASSERTIONS'
    COMPONENT_TARGET.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix='windoesnot-terminal-') as temp:
        work = Path(temp)
        shutil.copytree(COMPONENT_SOURCE, work / 'terminalmodule')
        run('cmake', '-S', str(work / 'terminalmodule'), '-B', str(work / 'terminal-build'),
            '-G', 'Ninja', '-DCMAKE_BUILD_TYPE=Release',
            '-DCMAKE_BUILD_WITH_INSTALL_RPATH=ON', '-DCMAKE_INSTALL_RPATH=$ORIGIN', env=env)
        run('cmake', '--build', str(work / 'terminal-build'), '-j',
            str(os.cpu_count() or 1), env=env)
        built = work / 'widgets/terminalmodule/LocalTerminal'
        for name in required:
            path = built / name
            if not path.is_file() or not path.stat().st_size:
                raise RuntimeError(f'Missing terminal build result: {name}')
        for library in built.glob('*.so'):
            dynamic = run('readelf', '-d', str(library), capture_output=True, text=True).stdout
            for line in dynamic.splitlines():
                if '(RUNPATH)' in line or '(RPATH)' in line:
                    if '[$ORIGIN]' not in line:
                        raise RuntimeError(f'Unexpected terminal RUNPATH: {library}')
        staged = Path(tempfile.mkdtemp(prefix='.LocalTerminal.', dir=COMPONENT_TARGET.parent))
        exchanged = False
        installed = False
        try:
            for path in built.iterdir():
                destination = staged / path.name
                if path.is_dir():
                    shutil.copytree(path, destination)
                else:
                    shutil.copy2(path, destination)
            if COMPONENT_TARGET.exists():
                exchange_directories(staged, COMPONENT_TARGET)
                exchanged = True
            else:
                os.replace(staged, COMPONENT_TARGET)
                installed = True
            if os.environ.get('WDN_REBUILD_TEST_FAIL_AFTER_COMPONENT_REPLACE'):
                raise RuntimeError('Injected terminal replacement failure')
            write_marker(COMPONENT_MARKER, expected)
        except Exception:
            if exchanged:
                exchange_directories(staged, COMPONENT_TARGET)
            elif installed:
                os.replace(COMPONENT_TARGET, staged)
            raise
        finally:
            if staged.exists():
                shutil.rmtree(staged)
    logging.info('Rebuilt terminal for %s', expected.splitlines()[:3])


def main():
    try:
        LOG.parent.mkdir(parents=True, exist_ok=True)
        logging.basicConfig(filename=LOG, level=logging.INFO,
                            format='%(asctime)s %(levelname)s %(message)s')
        for source, action, label in ((SOURCE, rebuild, 'Plugin'),
                                      (COMPONENT_SOURCE, rebuild_components, 'Terminal')):
            if not source.is_dir():
                continue
            try:
                action()
            except Exception:
                logging.exception('%s rebuild failed', label)
                try:
                    notify_failure('terminal' if label == 'Terminal' else 'plugins')
                except Exception:
                    logging.exception('Failure notification failed')
    except Exception:
        logging.exception('Rebuild setup failed')
    return 0


if __name__ == '__main__':
    sys.exit(main())
