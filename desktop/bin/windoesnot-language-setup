#!/usr/bin/env python3
"""Use the desktop's Polkit agent for language setup; never open a terminal."""
import argparse
import os
from pathlib import Path
import stat
import sys
import xml.etree.ElementTree as ET

LOCALES = {'de': 'de_DE.UTF-8', 'en': 'en_US.UTF-8'}
HELPER = Path('/usr/lib/windoesnot/system_tools.py')
POLICY = Path('/usr/share/polkit-1/actions/org.windoesnot.system.policy')


def support_ready():
    try:
        for p in (HELPER, POLICY):
            info = p.stat()
            if p.is_symlink() or info.st_uid != 0 or stat.S_IMODE(info.st_mode) & 0o022:
                return False
        return 'LANGUAGE_SETUP_API = 1' in HELPER.read_text() and any(
            a.attrib.get('id') == 'org.windoesnot.system.locale-set' for a in ET.parse(POLICY).findall('action'))
    except (OSError, ET.ParseError):
        return False


def main():
    import json
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('language', choices=LOCALES)
    args = parser.parse_args()
    locale = LOCALES[args.language]
    if support_ready():
        command = ['/usr/bin/pkexec', '--disable-internal-agent', str(HELPER), 'locale-set', json.dumps({'locale': locale})]
    else:
        candidates = [Path(os.environ.get('WINDOESNOT_SOURCE', '/usr/share/windoesnot')),
                      Path.home() / 'windoesnot']
        installer = next((p / 'tools/install-language-support.py' for p in candidates
                          if (p / 'tools/install-language-support.py').is_file()), None)
        if installer is None:
            print(json.dumps({'error': 'The installed system tools need updating'}), flush=True)
            return 1
        command = ['/usr/bin/pkexec', '--disable-internal-agent', '/usr/bin/python3', '-I', str(installer),
                   '--apply', '--locale', locale]
    os.execv(command[0], command)


if __name__ == '__main__':
    sys.exit(main())
