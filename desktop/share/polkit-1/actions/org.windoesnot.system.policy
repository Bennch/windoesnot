  <action id="org.windoesnot.system.nearby-ports-set">
    <description>Open or close the LocalSend port in the firewall</description>
    <description xml:lang="de">LocalSend-Port in der Firewall öffnen oder schließen</description>
    <message>Please confirm: Open or close the LocalSend port in the firewall</message>
    <message xml:lang="de">Bitte bestätigen: LocalSend-Port in der Firewall öffnen oder schließen</message>
