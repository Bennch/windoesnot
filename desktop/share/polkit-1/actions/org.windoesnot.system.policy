    <annotate key="org.freedesktop.policykit.exec.argv1">keyring-repair</annotate>
  </action>
  <action id="org.windoesnot.system.lock-remove">
    <description>Remove a stale package lock</description>
    <description xml:lang="de">Hängende Paketsperre entfernen</description>
    <message>Please confirm: Remove a stale package lock</message>
    <message xml:lang="de">Bitte bestätigen: Hängende Paketsperre entfernen</message>
