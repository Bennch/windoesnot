    <annotate key="org.freedesktop.policykit.exec.argv1">lock-remove</annotate>
  </action>
  <action id="org.windoesnot.system.orphans-remove">
    <description>Remove reviewed unused packages</description>
    <description xml:lang="de">Geprüfte ungenutzte Pakete entfernen</description>
    <message>Please confirm: Remove reviewed unused packages</message>
    <message xml:lang="de">Bitte bestätigen: Geprüfte ungenutzte Pakete entfernen</message>
