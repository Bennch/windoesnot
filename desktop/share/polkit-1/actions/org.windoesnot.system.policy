  </action>
  <action id="org.windoesnot.system.drivers-configure">
    <description>Update the system and configure graphics drivers</description>
    <description xml:lang="de">System aktualisieren und Grafiktreiber einrichten</description>
    <message>Please confirm: Update the system and configure graphics drivers</message>
    <message xml:lang="de">Bitte bestätigen: System aktualisieren und Grafiktreiber einrichten</message>
