    <annotate key="org.freedesktop.policykit.exec.argv1">password-change</annotate>
  </action>
  <action id="org.windoesnot.system.avatar-set">
    <description>Change your profile picture</description>
    <description xml:lang="de">Eigenes Profilbild ändern</description>
    <message>Please confirm: Change your profile picture</message>
    <message xml:lang="de">Bitte bestätigen: Eigenes Profilbild ändern</message>
    <icon_name>system-lock-screen</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
