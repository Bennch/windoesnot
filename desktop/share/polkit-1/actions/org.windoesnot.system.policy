    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/windoesnot/system_tools.py</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">keyring-repair</annotate>
  </action>
  <action id="org.windoesnot.system.lock-remove">
    <description>Remove a stale package lock</description>
    <description xml:lang="de">Hängende Paketsperre entfernen</description>
    <message>Please confirm: Remove a stale package lock</message>
    <message xml:lang="de">Bitte bestätigen: Hängende Paketsperre entfernen</message>
    <icon_name>system-lock-screen</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/windoesnot/system_tools.py</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">lock-remove</annotate>
  </action>
  <action id="org.windoesnot.system.orphans-remove">
    <description>Remove reviewed unused packages</description>
    <description xml:lang="de">Geprüfte ungenutzte Pakete entfernen</description>
    <message>Please confirm: Remove reviewed unused packages</message>
    <message xml:lang="de">Bitte bestätigen: Geprüfte ungenutzte Pakete entfernen</message>
    <icon_name>system-lock-screen</icon_name>
