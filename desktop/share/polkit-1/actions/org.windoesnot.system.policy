  <action id="org.windoesnot.system.sddm-set-theme">
    <description>Change the login screen theme</description>
    <description xml:lang="de">Anmeldebildschirm-Design ändern</description>
    <message>Please confirm: Change the login screen theme</message>
    <message xml:lang="de">Bitte bestätigen: Anmeldebildschirm-Design ändern</message>
    <icon_name>system-lock-screen</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
