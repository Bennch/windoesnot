    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/windoesnot/system_tools.py</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">mirrors-rank</annotate>
  </action>
  <action id="org.windoesnot.system.cache-clean">
    <description>Clean old downloaded packages</description>
    <description xml:lang="de">Alte heruntergeladene Pakete aufräumen</description>
    <message>Please confirm: Clean old downloaded packages</message>
    <message xml:lang="de">Bitte bestätigen: Alte heruntergeladene Pakete aufräumen</message>
    <icon_name>system-lock-screen</icon_name>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/windoesnot/system_tools.py</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">cache-clean</annotate>
  </action>
  <action id="org.windoesnot.system.keyring-repair">
    <description>Repair official signing keys and update the system</description>
    <description xml:lang="de">Offizielle Paketschlüssel reparieren und System aktualisieren</description>
    <message>Please confirm: Repair official signing keys and update the system</message>
    <message xml:lang="de">Bitte bestätigen: Offizielle Paketschlüssel reparieren und System aktualisieren</message>
