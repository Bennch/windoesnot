#!/bin/sh
# Boot-time hardware gate: frees nouveau for legacy NVIDIA devices listed by chwd and switches lite mode on
# (once) for legacy GPUs and for machines that are too weak for the full desktop.
set -eu

id_file=${WINDOESNOT_NOUVEAU_IDS:-/var/lib/chwd/ids/nouveau.ids}
override=${WINDOESNOT_MODPROBE_OVERRIDE:-/etc/modprobe.d/nvidia-utils.conf}
lite_flag=${WINDOESNOT_LITE_FLAG:-/etc/windoesnot/lite-mode}
lite_marker=${WINDOESNOT_LITE_MARKER:-/var/lib/windoesnot/old-gpu-lite-decided}
nvidia_blacklist=${WINDOESNOT_NVIDIA_BLACKLIST:-/etc/modprobe.d/windoesnot-legacy-nvidia.conf}

lite_env=${WINDOESNOT_LITE_ENV:-/run/windoesnot/lite.env}

# Whatever happens below, hand the greeter (SDDM) the lite mode rendering settings for this boot.
sync_lite_env() {
    if [ -e "$lite_flag" ]; then
        mkdir -p "${lite_env%/*}"
        printf 'QT_QUICK_BACKEND=software\nGSK_RENDERER=cairo\n' > "$lite_env"
    else
        rm -f "$lite_env"
    fi
}
trap sync_lite_env EXIT

cpuinfo=${WINDOESNOT_CPUINFO:-/proc/cpuinfo}
meminfo=${WINDOESNOT_MEMINFO:-/proc/meminfo}

# Machines that are too weak for the full desktop also start in lite mode, once: less than 3 GiB of
# memory or a processor without SSE4.1 (designs from 2008 and older). The user can switch it off in
# Settings; the marker keeps later boots from undoing that.
lowend_reason() {
    mem_kib=$(sed -n 's/^MemTotal:[[:space:]]*\([0-9][0-9]*\) kB.*/\1/p' "$meminfo" 2>/dev/null | head -n 1)
    if [ -n "${mem_kib:-}" ] && [ "$mem_kib" -lt 3145728 ]; then
        echo "less than 3 GiB of memory (${mem_kib} kB)"
        return 0
    fi
    if [ -r "$cpuinfo" ] && grep -q '^flags' "$cpuinfo" && ! grep -m1 '^flags' "$cpuinfo" | grep -qw sse4_1; then
        echo "processor without SSE4.1"
        return 0
    fi
    return 1
}
if [ ! -e "$lite_marker" ] && reason=$(lowend_reason); then
    mkdir -p "${lite_flag%/*}" "${lite_marker%/*}"
    : > "$lite_flag"
    : > "$lite_marker"
    logger -t windoesnot-old-gpu "lite mode switched on: $reason" 2>/dev/null || true
fi

[ -r "$id_file" ] || exit 0

devices=$(
    lspci -n -d 10de::0300 2>/dev/null || true
    lspci -n -d 10de::0302 2>/dev/null || true
)
[ -n "$devices" ] || exit 0

ids=$(tr '[:upper:]' '[:lower:]' < "$id_file")
for device_id in $(printf '%s\n' "$devices" | sed -nE 's/.*10de:([[:xdigit:]]{4}).*/\1/p'); do
    device_id=$(printf '%s' "$device_id" | tr '[:upper:]' '[:lower:]')
    case " $ids " in
        *" $device_id "*)
            mkdir -p "${override%/*}"
            : > "$override"
            # cachyos-drm-awaiter waits for nvidia_drm while the nvidia module is loadable: with the
            # module blacklisted for this legacy card it waits for nouveau instead.
            printf '%s\n' '# WinDoesNot: this GPU is driven by nouveau; the NVIDIA modules cannot drive it.' \
                'blacklist nvidia' 'blacklist nvidia_drm' 'blacklist nvidia_modeset' 'blacklist nvidia_uvm' > "$nvidia_blacklist"
            # Lite mode is switched on once, at the first detection. Later boots must not undo the
            # user's choice when lite mode was switched off in Settings.
            if [ ! -e "$lite_marker" ]; then
                mkdir -p "${lite_flag%/*}" "${lite_marker%/*}"
                : > "$lite_flag"
                : > "$lite_marker"
            fi
            logger -t windoesnot-old-gpu "nouveau device $device_id found in chwd IDs; cleared nvidia-utils blacklist"
            modprobe nouveau || logger -t windoesnot-old-gpu "modprobe nouveau failed; software rendering stays active via Lite Mode"
            exit 0
            ;;
    esac
done
exit 0
