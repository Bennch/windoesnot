#!/bin/sh
# Clear nvidia-utils' nouveau blacklist only for devices listed by chwd.
set -eu

id_file=${WINDOESNOT_NOUVEAU_IDS:-/var/lib/chwd/ids/nouveau.ids}
override=${WINDOESNOT_MODPROBE_OVERRIDE:-/etc/modprobe.d/nvidia-utils.conf}
lite_flag=${WINDOESNOT_LITE_FLAG:-/etc/windoesnot/lite-mode}

[ -r "$id_file" ] || exit 0

devices=$(
    lspci -n -d 10de::0300 2>/dev/null || true
    lspci -n -d 10de::0302 2>/dev/null || true
)
[ -n "$devices" ] || exit 0

ids=$(tr '[:upper:]' '[:lower:]' < "$id_file")
for device_id in $(printf '%s\n' "$devices" | sed -nE 's/.*10de:([[:xdigit:]]{4}).*/\1/p'); do
    device_id=$(printf '%s' "$device_id" | tr '[:upper:]' '[:lower:]')
    case " $ids " in
        *" $device_id "*)
            mkdir -p "${override%/*}"
            : > "$override"
            mkdir -p "${lite_flag%/*}"
            : > "$lite_flag"
            logger -t windoesnot-old-gpu "nouveau device $device_id found in chwd IDs; cleared nvidia-utils blacklist"
            modprobe nouveau || logger -t windoesnot-old-gpu "modprobe nouveau failed; software rendering stays active via Lite Mode"
            exit 0
            ;;
    esac
done
exit 0
