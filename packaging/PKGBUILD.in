# Generated local source archive; distribution is intentionally not configured yet.
pkgbase=windoesnot
pkgname=(windoesnot-desktop windoesnot-tools windoesnot-plugins windoesnot-components)
pkgver=@VERSION@
pkgrel=@RELEASE@
pkgdesc='WinDoesNot Hyprland/Quickshell desktop (development build)'
arch=('x86_64')
license=('GPL-3.0-or-later' 'MIT' 'BSD-3-Clause')
makedepends=(gcc make cmake ninja pkgconf binutils wayland-protocols hyprland quickshell qt6-base qt6-declarative qtermwidget wayland cairo pango glib2 librsvg json-c libxkbcommon python)
options=('!strip' '!debug' '!lto')
source=("windoesnot-${pkgver}.tar.gz")
sha256sums=('@SHA256@')

build() {
    cd "$srcdir/windoesnot-$pkgver"
    ./tools/build-components.sh "$srcdir/components"
}

# Same upstream version and package release as the build; a CPU-level rebuild
# suffix (.1 from cachyos-v3/v4/znver4) is allowed, a real rebuild is not.
_abi() {
    local version upstream release
    version=$(pacman -Q "$1" | cut -d' ' -f2)
    upstream=${version%-*}
    release=${version##*-}
    release=${release%%.*}
    printf '%s\n' "$1>=$upstream-$release" "$1<$upstream-$((release + 1))"
}

_license() {
    install -Dm644 "$srcdir/windoesnot-$pkgver/packaging/LICENSE-NOTES.md" "$pkgdir/usr/share/licenses/$pkgname/LICENSE-NOTES.md"
    install -Dm644 "$srcdir/windoesnot-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 "$srcdir/windoesnot-$pkgver/THIRD-PARTY.md" "$pkgdir/usr/share/licenses/$pkgname/THIRD-PARTY.md"
}

package_windoesnot-desktop() {
    pkgdesc='WinDoesNot desktop code and new-user defaults'
    depends=("windoesnot-tools=$pkgver-$pkgrel" "windoesnot-plugins=$pkgver-$pkgrel" "windoesnot-components=$pkgver-$pkgrel" windoesnot-device-manager windoesnot-bluetooth windoesnot-network quickshell hyprland hyprpaper hyprpicker hyprlock hypridle hyprshot ghostty nautilus localsend xorg-setxkbmap python-gobject python-cairo python-evdev python-requests python-websockets qt6-5compat qt6-svg qt6-multimedia qt6-wayland qt6-declarative gtk4-layer-shell adw-gtk-theme swaync wl-clipboard wl-clip-persist cliphist jq libnotify grim slurp xdg-desktop-portal-hyprland xdg-desktop-portal-gtk xdg-user-dirs ttf-jetbrains-mono-nerd ttf-nerd-fonts-symbols noto-fonts-emoji fish polkit-gnome network-manager-applet nm-connection-editor pavucontrol blueman)
    cd "$srcdir/windoesnot-$pkgver"
    install -d "$pkgdir/usr/share/windoesnot/desktop"
    cp -a desktop/config desktop/defaults "$pkgdir/usr/share/windoesnot/desktop/"
    printf '%s\n' "$pkgver-$pkgrel" > "$pkgdir/usr/share/windoesnot/desktop/config/windoesnot-release"
    printf '%s\n' "$pkgver-$pkgrel" > "$pkgdir/usr/share/windoesnot/VERSION"
    # What changed per release; Settings > Updates shows it.
    install -Dm644 packaging/changelog.json "$pkgdir/usr/share/windoesnot/changelog.json"
    install -Dm644 desktop/share/wayland-sessions/windoesnot.desktop "$pkgdir/usr/share/wayland-sessions/windoesnot.desktop"
    install -Dm644 desktop/share/wayland-sessions/windoesnot.desktop "$pkgdir/usr/share/windoesnot/wayland-sessions/windoesnot.desktop"
    install -Dm644 desktop/share/applications/windoesnot-settings.desktop "$pkgdir/usr/share/applications/windoesnot-settings.desktop"
    install -d "$pkgdir/usr/share/icons/Win11"
    cp -a desktop/config/quickshell/default/img/Win11-dark/. "$pkgdir/usr/share/icons/Win11/"
    install -d "$pkgdir/usr/share/backgrounds/windoesnot"
    install -m644 desktop/share/backgrounds/windoesnot/*.jpg "$pkgdir/usr/share/backgrounds/windoesnot/"
    install -d "$pkgdir/usr/share/windoesnot/branding"
    install -m644 desktop/config/quickshell/default/img/brand/*.png "$pkgdir/usr/share/windoesnot/branding/"
    for size in 16 32 48 64 128 256 512 1024; do
        install -Dm644 "desktop/config/quickshell/default/img/brand/windoesnot-icon-$size.png" "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/windoesnot.png"
    done
    install -d "$pkgdir/usr/share/sddm/themes/windoesnot" "$pkgdir/usr/share/grub/themes/windoesnot"
    cp -a desktop/share/sddm/themes/windoesnot/. "$pkgdir/usr/share/sddm/themes/windoesnot/"
    install -Dm644 desktop/share/systemd/system/sddm.service.d/10-windoesnot-locale.conf "$pkgdir/usr/lib/systemd/system/sddm.service.d/10-windoesnot-locale.conf"
    # The greeter only sees system fonts; thyx's Plus Jakarta Sans (OFL) is installed for it.
    install -d "$pkgdir/usr/share/fonts/windoesnot"
    install -m644 desktop/share/sddm/themes/windoesnot/fonts/*.ttf "$pkgdir/usr/share/fonts/windoesnot/"
    cp -a desktop/share/grub/themes/windoesnot/. "$pkgdir/usr/share/grub/themes/windoesnot/"
    _license
}

package_windoesnot-tools() {
    pkgdesc='WinDoesNot session, layout, settings and user-code migration tools'
    depends=(python python-evdev python-gobject python-cairo hyprland polkit cachyos-rate-mirrors pacman-contrib btrfs-progs diffutils)
    cd "$srcdir/windoesnot-$pkgver"
    install -d "$pkgdir/usr/bin"
    for command in desktop/bin/*; do
        install -m755 "$command" "$pkgdir/usr/bin/$(basename "$command")"
    done
    install -Dm755 desktop/lib/windoesnot/system_tools.py "$pkgdir/usr/lib/windoesnot/system_tools.py"
    install -Dm644 desktop/share/polkit-1/actions/org.windoesnot.system.policy "$pkgdir/usr/share/polkit-1/actions/org.windoesnot.system.policy"
    install -Dm755 desktop/lib/windoesnot/snapshots.py "$pkgdir/usr/lib/windoesnot/snapshots.py"
    install -Dm644 desktop/share/polkit-1/actions/org.windoesnot.snapshots.policy "$pkgdir/usr/share/polkit-1/actions/org.windoesnot.snapshots.policy"
    install -Dm644 desktop/share/systemd/system/windoesnot-super-tap@.service "$pkgdir/usr/lib/systemd/system/windoesnot-super-tap@.service"
    install -Dm644 desktop/share/systemd/system/windoesnot-first-network.service "$pkgdir/usr/lib/systemd/system/windoesnot-first-network.service"
    install -Dm755 desktop/share/NetworkManager/dispatcher.d/90-windoesnot-first-network "$pkgdir/usr/lib/NetworkManager/dispatcher.d/90-windoesnot-first-network"
    # Public verification material for future images; repository setup is explicit.
    install -Dm644 packaging/release-key/RELEASE-KEY.asc "$pkgdir/usr/share/windoesnot/repository/RELEASE-KEY.asc"
    install -Dm644 packaging/release-key/RELEASE-KEY.fingerprint "$pkgdir/usr/share/windoesnot/repository/RELEASE-KEY.fingerprint"
    _license
}

package_windoesnot-plugins() {
    pkgdesc='WinDoesNot hyprbars and hyprdrag built for a specific Hyprland package'
    depends=($(_abi hyprland) $(_abi libstdc++))
    install -d "$pkgdir/usr/lib/windoesnot/plugins"
    install -m755 "$srcdir/components/plugins/"*.so "$pkgdir/usr/lib/windoesnot/plugins/"
    install -Dm644 "$srcdir/components/BUILD-PACKAGES.txt" "$pkgdir/usr/share/windoesnot/plugins-build.txt"
    install -Dm644 "$srcdir/components/NATIVE-FLAGS.txt" "$pkgdir/usr/share/windoesnot/plugins-flags.txt"
    _license
}

package_windoesnot-components() {
    pkgdesc='WinDoesNot embedded terminal and patched Snappy window switcher'
    depends=($(_abi qt6-base) $(_abi qtermwidget) qt6-declarative wayland cairo pango libxkbcommon glib2 librsvg json-c)
    conflicts=(snappy-switcher snappy-switcher-git)
    provides=(snappy-switcher=2.1.2)
    install -d "$pkgdir/usr/lib/windoesnot/LocalTerminal"
    cp -a "$srcdir/components/LocalTerminal/." "$pkgdir/usr/lib/windoesnot/LocalTerminal/"
    install -Dm755 "$srcdir/components/bin/snappy-switcher" "$pkgdir/usr/bin/snappy-switcher"
    install -Dm644 "$srcdir/components/BUILD-PACKAGES.txt" "$pkgdir/usr/share/windoesnot/components-build.txt"
    install -Dm644 "$srcdir/components/NATIVE-FLAGS.txt" "$pkgdir/usr/share/windoesnot/components-flags.txt"
    _license
}
