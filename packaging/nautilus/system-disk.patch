diff --color -ruN '--exclude=build' -x '*.orig' nautilus-51.1/src/nautilus-computer-cell.c ../nautilus-51.1/src/nautilus-computer-cell.c
--- a/src/nautilus-computer-cell.c	2026-11-21 16:33:39.503810180 +0100
+++ b/src/nautilus-computer-cell.c	2026-11-21 16:41:20.019612574 +0100
@@ -63,6 +63,23 @@
     g_object_get (view, "collapsed-mask", &mask, NULL);
     collapsed = (mask & (1u << cell_section (nautilus_view_item_get_file (item)))) != 0;
 
+    /* The extension sets "wdn_hide" = "1" on the drive item of the system disk: the root item carries its name, so this
+     * second entry (which cannot be mounted) takes no room, the same way a folded section does. */
+    {
+        static GQuark hide_q = 0;
+        g_autofree char *hide = NULL;
+
+        if (hide_q == 0)
+        {
+            hide_q = g_quark_from_static_string ("wdn_hide");
+        }
+        hide = nautilus_file_get_string_attribute_q (nautilus_view_item_get_file (item), hide_q);
+        if (hide != NULL && hide[0] == '1')
+        {
+            collapsed = TRUE;
+        }
+    }
+
     gtk_widget_set_visible (self->box, !collapsed);
     if (row != NULL)
     {
@@ -90,11 +107,12 @@
 update_from_file (NautilusComputerCell *self)
 {
     g_autoptr (NautilusViewItem) item = nautilus_view_cell_get_item (NAUTILUS_VIEW_CELL (self));
-    static GQuark percent_q = 0, space_q = 0;
+    static GQuark percent_q = 0, space_q = 0, label_q = 0;
     NautilusFile *file;
     g_autoptr (GIcon) icon = NULL;
     g_autofree char *percent_text = NULL;
     g_autofree char *space_text = NULL;
+    g_autofree char *label_text = NULL;
     const char *name = NULL;
 
     g_return_if_fail (item != NULL);
@@ -103,13 +121,16 @@
     {
         percent_q = g_quark_from_static_string ("wdn_percent");
         space_q = g_quark_from_static_string ("wdn_space");
+        label_q = g_quark_from_static_string ("wdn_label");
     }
 
     file = nautilus_view_item_get_file (item);
     icon = nautilus_file_get_gicon (file, NAUTILUS_FILE_ICON_FLAGS_NONE);
     gtk_image_set_from_gicon (GTK_IMAGE (self->icon), icon);
 
-    name = nautilus_file_get_display_name (file);
+    /* The extension may give the item a better name (the system disk: "<disk name> (System disk)") */
+    label_text = nautilus_file_get_string_attribute_q (file, label_q);
+    name = (label_text != NULL && label_text[0] != '\0') ? label_text : nautilus_file_get_display_name (file);
     gtk_label_set_label (GTK_LABEL (self->name), name);
 
     percent_text = nautilus_file_get_string_attribute_q (file, percent_q);
